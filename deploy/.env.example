# Dev-only credentials. Copied to deploy/.env by scripts/dev-up.sh.
RMM_PG_PASSWORD=dev-only-pg-password
RMM_NATS_API_PASSWORD=dev-only-nats-api
RMM_NATS_INGEST_PASSWORD=dev-only-nats-ingest
RMM_NATS_AUTHD_PASSWORD=dev-only-nats-authd
RMM_NATS_SYS_PASSWORD=dev-only-nats-sys
RMM_HTTPS_PORT=443
# Values compose passes to the server services.
RMM_DATABASE_URL=postgres://rmm:dev-only-pg-password@timescale:5432/rmm
RMM_NATS_URL=nats://nats:4222
# NATS auth callout issuer (account nkey). Left empty here: scripts/dev-up.sh
# generates a pair with `rmm-server gen-nkey --type account` into deploy/.env.
RMM_AUTHD_ISSUER_SEED=
RMM_AUTHD_ISSUER_PUBKEY=
# Root public key(s), comma separated hex, and threshold. scripts/dev-up.sh
# runs scripts/dev-trust.sh and writes RMM_ROOT_PUBKEYS into deploy/.env.
RMM_ROOT_PUBKEYS=
RMM_ROOT_THRESHOLD=1
# Hardware-only WebAuthn registration. Technicians can register a credential
# only with a packed attestation chaining to a root in this PEM bundle and an
# AAGUID in this comma-separated hex list; registration answers 503 when either
# is unset. Production: the vendor's FIDO attestation root(s) and the YubiKey 5
# AAGUIDs you issue. Dev: the dev fake authenticator (`cargo run -p xtask -- fake-authn ca`) writes its
# test root to deploy/dev/webauthn/attestation-root.pem, mounted into the api
# container, and uses the AAGUID below ("rmm-dev-fake-key" in ASCII). Sign a
# techlist holding that credential with `rmm-sign ... --allow-aaguid` set to
# the same value; it is not a YubiKey AAGUID.
RMM_WEBAUTHN_ATTESTATION_ROOTS=/run/rmm-webauthn/attestation-root.pem
RMM_WEBAUTHN_AAGUIDS=726d6d2d6465762d66616b652d6b6579
# Dev only: never set the two WebAuthn values above to the dev root or the dev
# AAGUID in production, or anyone holding deploy/dev/webauthn can register.
# Shell recordings are kept this many days, then deleted with their rows.
RMM_RECORDING_RETENTION_DAYS=365
# Loopback port the API listens on for the dev end-to-end shell script.
RMM_API_PORT=8080
