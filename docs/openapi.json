{
  "openapi": "3.1.0",
  "info": {
    "title": "RMM API",
    "description": "HTTP API routes and OpenAPI document",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/action-runs/{cmd_id}": {
      "get": {
        "tags": [
          "actions"
        ],
        "summary": "Read an action run.",
        "operationId": "get_action_run",
        "parameters": [
          {
            "name": "cmd_id",
            "in": "path",
            "description": "Command id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionRunResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/agents/{agent_id}/actions": {
      "post": {
        "tags": [
          "actions"
        ],
        "summary": "Invoke a catalog definition on an agent.",
        "operationId": "issue_action",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "description": "Agent id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Command signed, recorded and published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Agent is not active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unknown definition or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Command key missing or command not published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/agents/{agent_id}/revoke": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Revoke an agent and tell NATS to drop its connection.",
        "operationId": "revoke_agent",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "description": "Agent id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Agent revoked and connection kick published"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or superseded agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Agent revoked but the kick was not published; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/catalog": {
      "put": {
        "tags": [
          "actions"
        ],
        "summary": "Upload a catalog-signed definition envelope.",
        "operationId": "put_catalog",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Definition already stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogEntry"
                }
              }
            }
          },
          "201": {
            "description": "Definition stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogEntry"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Not catalog-signed, invalid or revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/devices/{device_id}/approve": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Approve a device held for review (`pending_review` or `flagged`).",
        "operationId": "approve_device",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "description": "Device id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Device and its agent activated; the original device's agents superseded"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown device or not held for review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Approved but the kick of superseded agents was not published; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/devices/{device_id}/reject": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Reject a device held for review: its agents are revoked.",
        "operationId": "reject_device",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "description": "Device id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Agents of the device revoked and kick published"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown device or not held for review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Rejected but the kick was not published; retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/enrollment-tokens": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create an enrollment token.",
        "operationId": "create_enrollment_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Token created (shown once)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/trust/{kind}": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Upload a signed trust artifact.",
        "operationId": "put_trust",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "description": "manifest, revocations or techlist",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Artifact verified and stored"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Verification failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "tags": [],
        "summary": "Liveness probe.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/enroll": {
      "post": {
        "tags": [
          "enroll"
        ],
        "summary": "Enroll a new agent.",
        "operationId": "enroll",
        "requestBody": {
          "description": "EnrollRequest (rmm_proto::enroll)",
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Enrolled; body is an EnrollResponse",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Bad token or proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Public key already enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionRunResponse": {
        "type": "object",
        "description": "State of an action run.",
        "required": [
          "cmd_id",
          "status",
          "stages",
          "created_at"
        ],
        "properties": {
          "cmd_id": {
            "type": "string",
            "description": "Command id."
          },
          "created_at": {
            "type": "string",
            "description": "Creation time (RFC 3339)."
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Completion time (RFC 3339), once the agent reported."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Rejection reason, when rejected."
          },
          "stages": {
            "type": "object",
            "description": "Per-stage outcomes reported by the agent."
          },
          "status": {
            "type": "string",
            "description": "`queued`, `succeeded`, `failed`, `rolled_back`, `rejected` or `expired`."
          }
        }
      },
      "CatalogEntry": {
        "type": "object",
        "description": "A stored catalog definition.",
        "required": [
          "content_id",
          "id",
          "version",
          "capability",
          "new"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "description": "Capability group."
          },
          "content_id": {
            "type": "string",
            "description": "Hex SHA-256 of the definition payload."
          },
          "id": {
            "type": "string",
            "description": "Dotted action name."
          },
          "new": {
            "type": "boolean",
            "description": "False when the same definition was already stored."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Definition version.",
            "minimum": 0
          }
        }
      },
      "CreateTokenRequest": {
        "type": "object",
        "description": "Request to mint an enrollment token.",
        "required": [
          "client_id",
          "site_id",
          "expires_in_hours",
          "max_uses",
          "allow_reattach"
        ],
        "properties": {
          "allow_reattach": {
            "type": "boolean",
            "description": "Whether a device may be reattached by this token."
          },
          "client_id": {
            "type": "string",
            "description": "Client the token belongs to."
          },
          "expires_in_hours": {
            "type": "integer",
            "format": "int64",
            "description": "Lifetime in hours (1..=720)."
          },
          "max_uses": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum uses (1..=1000)."
          },
          "site_id": {
            "type": "string",
            "description": "Site devices enroll into."
          }
        }
      },
      "CreateTokenResponse": {
        "type": "object",
        "description": "A freshly minted token; the secret is shown only here.",
        "required": [
          "token",
          "token_id",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "description": "Expiry instant (RFC 3339)."
          },
          "token": {
            "type": "string",
            "description": "Token secret (`rmmenr_...`)."
          },
          "token_id": {
            "type": "string",
            "description": "Token id."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "JSON error body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable reason."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Body returned by the health endpoint.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the process is serving."
          }
        }
      },
      "IssueRequest": {
        "type": "object",
        "description": "Request to invoke a catalog definition on one agent.",
        "required": [
          "definition_content_id"
        ],
        "properties": {
          "definition_content_id": {
            "type": "string",
            "description": "Hex content id of an uploaded definition."
          },
          "params": {
            "type": "object",
            "description": "Parameters, validated against the definition."
          }
        }
      },
      "IssueResponse": {
        "type": "object",
        "description": "An accepted command.",
        "required": [
          "cmd_id"
        ],
        "properties": {
          "cmd_id": {
            "type": "string",
            "description": "Command id; poll `/api/v1/action-runs/{cmd_id}`."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
