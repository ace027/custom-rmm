              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Missing RMM.Admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Verification failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "tags": [],
        "summary": "Liveness probe.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/enroll": {
      "post": {
        "tags": [
          "enroll"
        ],
        "summary": "Enroll a new agent.",
        "operationId": "enroll",
        "requestBody": {
          "description": "EnrollRequest (rmm_proto::enroll)",
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Enrolled; body is an EnrollResponse",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Bad token or proof",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Public key already enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionRunResponse": {
        "type": "object",
        "description": "State of an action run.",
        "required": [
          "cmd_id",
          "status",
          "stages",
          "created_at"
        ],
        "properties": {
          "cmd_id": {
            "type": "string",
            "description": "Command id."
          },
          "created_at": {
            "type": "string",
            "description": "Creation time (RFC 3339)."
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Completion time (RFC 3339), once the agent reported."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Rejection reason, when rejected."
          },
          "stages": {
            "type": "object",
            "description": "Per-stage outcomes reported by the agent."
          },
          "status": {
            "type": "string",
            "description": "`queued`, `succeeded`, `failed`, `rolled_back`, `rejected` or `expired`."
          }
        }
      },
      "AuthenticatorSelection": {
        "type": "object",
        "description": "`authenticatorSelection` of the creation options.",
        "required": [
          "user_verification",
          "resident_key"
        ],
        "properties": {
          "resident_key": {
            "type": "string",
            "description": "Always `discouraged`."
          },
          "user_verification": {
            "type": "string",
            "description": "Always `required`."
          }
        }
      },
      "CatalogEntry": {
        "type": "object",
        "description": "A stored catalog definition.",
        "required": [
          "content_id",
          "id",
          "version",
          "capability",
          "new"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "description": "Capability group."
          },
          "content_id": {
            "type": "string",
            "description": "Hex SHA-256 of the definition payload."
          },
          "id": {
            "type": "string",
            "description": "Dotted action name."
          },
          "new": {
            "type": "boolean",
            "description": "False when the same definition was already stored."
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Definition version.",
            "minimum": 0
          }
        }
      },
      "CreateTokenRequest": {
        "type": "object",
        "description": "Request to mint an enrollment token.",
        "required": [
          "client_id",
          "site_id",
          "expires_in_hours",
          "max_uses",
          "allow_reattach"
        ],
        "properties": {
          "allow_reattach": {
            "type": "boolean",
            "description": "Whether a device may be reattached by this token."
          },
          "client_id": {
            "type": "string",
            "description": "Client the token belongs to."
          },
          "expires_in_hours": {
            "type": "integer",
            "format": "int64",
            "description": "Lifetime in hours (1..=720)."
          },
          "max_uses": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum uses (1..=1000)."
          },
          "site_id": {
            "type": "string",
            "description": "Site devices enroll into."
          }
        }
      },
      "CreateTokenResponse": {
        "type": "object",
        "description": "A freshly minted token; the secret is shown only here.",
        "required": [
          "token",
          "token_id",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "description": "Expiry instant (RFC 3339)."
          },
          "token": {
            "type": "string",
            "description": "Token secret (`rmmenr_...`)."
          },
          "token_id": {
            "type": "string",
            "description": "Token id."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "JSON error body.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable reason."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Body returned by the health endpoint.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok` when the process is serving."
          }
        }
      },
      "IssueRequest": {
        "type": "object",
        "description": "Request to invoke a catalog definition on one agent.",
        "required": [
          "definition_content_id"
        ],
        "properties": {
          "definition_content_id": {
            "type": "string",
            "description": "Hex content id of an uploaded definition."
          },
          "params": {
            "type": "object",
            "description": "Parameters, validated against the definition."
          }
        }
      },
      "IssueResponse": {
        "type": "object",
        "description": "An accepted command.",
        "required": [
          "cmd_id"
        ],
        "properties": {
          "cmd_id": {
            "type": "string",
            "description": "Command id; poll `/api/v1/action-runs/{cmd_id}`."
          }
        }
      },
      "RegisterBeginResponse": {
        "type": "object",
        "description": "Options for `navigator.credentials.create`.",
        "required": [
          "challenge_id",
          "challenge_b64url",
          "rp_id",
          "user_id_b64url",
          "user_name",
          "user_display_name",
          "timeout_ms",
          "attestation",
          "authenticator_selection",
          "pub_key_cred_params",
          "exclude_credentials_b64url"
        ],
        "properties": {
          "attestation": {
            "type": "string",
            "description": "Always `direct`."
          },
          "authenticator_selection": {
            "$ref": "#/components/schemas/AuthenticatorSelection",
            "description": "Authenticator requirements."
          },
          "challenge_b64url": {
            "type": "string",
            "description": "The challenge, unpadded base64url."
          },
          "challenge_id": {
            "type": "string",
            "description": "Pass back to `finish`."
          },
          "exclude_credentials_b64url": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Credentials already registered by this technician, unpadded base64url."
          },
          "pub_key_cred_params": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "COSE algorithms: -7 (ES256), -8 (EdDSA)."
          },
          "rp_id": {
            "type": "string",
            "description": "Relying party id (the manifest's `console_rp_id`)."
          },
          "timeout_ms": {
            "type": "integer",
            "format": "int32",
            "description": "Timeout in milliseconds.",
            "minimum": 0
          },
          "user_display_name": {
            "type": "string",
            "description": "User display name."
          },
          "user_id_b64url": {
            "type": "string",
            "description": "User handle, unpadded base64url."
          },
          "user_name": {
            "type": "string",
            "description": "User name (the technician id)."
          }
        }
      },
      "RegisterFinishRequest": {
        "type": "object",
        "description": "The authenticator's response to `navigator.credentials.create`.",
        "required": [
          "challenge_id",
          "attestation_object_b64url",
          "client_data_json_b64url"
        ],
        "properties": {
          "attestation_object_b64url": {
            "type": "string",
            "description": "`response.attestationObject`, unpadded base64url."
          },
          "challenge_id": {
            "type": "string",
            "description": "`challenge_id` from `begin`."
          },
          "client_data_json_b64url": {
            "type": "string",
            "description": "`response.clientDataJSON`, unpadded base64url."
          }
        },
        "additionalProperties": false
      },
      "RegisterFinishResponse": {
        "type": "object",
        "description": "A registered credential.",
        "required": [
          "cred_id_b64url",
          "aaguid_hex"
        ],
        "properties": {
          "aaguid_hex": {
            "type": "string",
            "description": "Authenticator AAGUID, lowercase hex."
          },
          "cred_id_b64url": {
            "type": "string",
            "description": "Credential id, unpadded base64url."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
